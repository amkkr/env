# =============================================================================
# GNU Readline Configuration
# https://www.gnu.org/software/bash/manual/html_node/Readline-Init-File-Syntax.html
# =============================================================================

# ~/.inputrc が存在すると /etc/inputrc は「フォールバック」扱いで読まれなくなる。
# Git for Windows の /etc/inputrc には Home/End/Delete/Ctrl-矢印のキーバインドや
# completion-ignore-case などが入っているため、先に取り込んでから上書きする。
# 存在しない環境（macOS 等）では黙って無視されるので安全。
# https://www.gnu.org/software/bash/manual/html_node/Conditional-Init-Constructs.html
$include /etc/inputrc

# -----------------------------------------------------------------------------
# Bell
# -----------------------------------------------------------------------------
# Git for Windows の /etc/inputrc が `set bell-style visible` を設定しているため、
# TAB 補完でベルが鳴るたびに readline が terminfo の flash
# (xterm-256color では DECSCNM: ESC[?5h ... ESC[?5l = 画面反転) を出力し、
# Windows Terminal の画面全体が一瞬白く光る。
# Windows Terminal の bellStyle は BEL(\a) 受信時しか制御しないので効かない。
set bell-style none
